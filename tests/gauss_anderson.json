{
  "output_root": "results/gauss_anderson",
  "common_params": {
    "seed": 0,
    "dimension": 50,
    "n_hidden": 2,
    "width_hidden": 32,
    "parametric_map": "node",
    "rhs_model": "mlp",
    "activation_fn": "tanh",
    "time_dependent": true,
    "ode_solver": "euler",
    "dt0": 0.1,
    "ref_density": "gaussian",
    "scale_factor": 0.1,
    "stepsize": 0.001,
    "N_samples": 3000,
    "eval_samples": 100,
    "plot_n_samples": 100,
    "max_iterations": 2000,
    "tolerance": 0.0001,
    "linear_solver": "cg",
    "live_plot_every": 100
  },  
  "problems": [
    {
      "functional": {
        "kind": "KL"
      },
      "distribution": {
        "name": "gaussian",
        "mean_value": 2.0,
        "sigma_max": 100.0,
        "sigma_min": 1.0,
        "orth_seed": 1
      }
    }
  ],
  "methods": {
    "gradient_flow": {
    },
    "anderson": {
      "relaxation": [1.00, 1.25],
      "regularization": [1e-1, 1e-3, 1e-6],
      "regularization_kind": ["l2", "adaptive"],
      "solver": ["cg"],
      "memory_size": [8],
      "ensure_descent": [true]
    }
  
  },
  "parallel": {"max_workers": 9, "gpu_ids": [0, 1, 2], "disable_preallocate": true},
    "plotting": {
    "figsize": [17, 6],
    "scatter_figsize": [8, 8],
    "method_colormaps": {
      "gradient_flow": "Greens",
      "anderson": "coolwarm"
    },
    "style_channels": ["color", "linestyle", "linewidth"],
    "style_values": {
      "linestyle": ["-", "--", ":", "-.", "-"],
      "linewidth": [1.5, 3.0]
    },
    "target_scatter_size": 6.0,
    "target_scatter_alpha": 0.9,
    "target_scatter_marker": "*",
    "target_scatter_facecolors": "none",
    "target_scatter_edgecolors": "#111111",
    "target_scatter_linewidths": 0.6,
    "target_scatter_zorder": 5,
    "target_scatter_label": "target"
  }
}
