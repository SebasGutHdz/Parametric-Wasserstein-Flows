{
  "experiment_name": "method_benchmark",
  "output_root": "results/bm_parallel",
  "common_params": {
    "seed": 0,
    "dimension": 2,
    "n_hidden": 2,
    "width_hidden": 128,
    "parametric_map": "node",
    "rhs_model": "mlp",
    "activation_fn": "tanh",
    "time_dependent": true,
    "ode_solver": "euler",
    "dt0": 0.1,
    "ref_density": "gaussian",
    "scale_factor": 1.0,
    "stepsize": 0.001,
    "N_samples": 3000,
    "eval_samples": 100,
    "plot_n_samples": 100,
    "max_iterations": 50,
    "tolerance": 0.0001,
    "linear_solver": "cg",
    "live_plot_every": 20
  },
  "distributions": [
    {
      "name": "styblinski-tang"
    }
  ],
  "methods": {
    "gradient_flow": {
    },
    "memoryless_qn": {
      "solver": ["cg"],
      "solver_regularization": [1e-6],
      "regularization_strategy": ["Li-Fukushima", "Powell"],
      "hessian_update_strategy": ["preconvex", "BFGS"],
      "spectral_scaling": [true, false]
    }
  },
  "parallel": {"max_workers": 8, "gpu_ids": [1, 2], "disable_preallocate": true},
  "plotting": {
    "figsize": [17, 6],
    "scatter_figsize": [8, 8],
    "colors": {
      "gradient_flow": "#1f77b4",
      "anderson": "#d62728",
      "memoryless_qn": "#2ca02c"
    },
    "linestyles": ["-", "--", ":", "-.", "-"],
    "linewidths": [2.3, 1.9, 1.5, 1.2, 1.0],
    "markers": ["o", "^", "s", "D", "x", "P", "*", "v"],
    "scatter_size": 22,
    "gf_alpha": 0.45,
    "method_alpha": 0.55
  }
}
