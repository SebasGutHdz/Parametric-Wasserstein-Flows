{
  "output_root": "results/mnist_conv_gf_only",
  "common_params": {
    "seed": 0,
    "dimension": 784,
    "n_hidden": 3,
    "width_hidden": 32,
    "parametric_map": "node",
    "rhs_model": "concat_conv2d",
    "activation_fn": "swish",
    "time_dependent": true,
    "ode_solver": "euler",
    "dt0": 0.1,
    "ref_density": "gaussian",
    "scale_factor": 0.1,
    "stepsize": 0.001,
    "N_samples": 100,
    "eval_samples": 100,
    "plot_n_samples": 64,
    "max_iterations": 2,
    "tolerance": 1e-6,
    "linear_solver": "cg",
    "live_plot_every": 2
  },
  "problems": [
    {
      "functional": {
        "kind": "MMD",
        "bw_multipliers": [0.001, 0.1, 1.0, 10.0],
        "bandwidth_samples": 10000
      },
      "distribution": {
        "name": "fashion",
        "n_samples": 10,
        "resample_each": 1,
        "seed": 3,
        "batch_size_sliced": 100,
        "sliced_n_draws": 8,
        "sliced_n_projections": 64,
        "n_rows": 6,
        "n_cols": 3,
        "data_root": "data/fashion"
      }
    }
  ],
  "methods": {
    "gradient_flow": {
      "stepsize": [1e-2, 1e-3, 1e-4],
      "regularization": [1e-1, 1e-3]
    }
  },
  "parallel": {
    "max_workers": 1,
    "gpu_ids": [],
    "disable_preallocate": true
  },
  "plotting": {
    "figsize": [17, 6],
    "scatter_figsize": [8, 8],
    "method_colormaps": {
      "adam": "Purples"
    },
    "style_channels": ["color", "linestyle", "linewidth"],
    "style_values": {
      "linestyle": ["-", "--", ":"],
      "linewidth": [2.0, 1.5]
    }
  }
}
