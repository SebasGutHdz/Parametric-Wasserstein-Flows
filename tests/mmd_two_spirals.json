{
  "output_root": "results/mmd_two_spirals_test",
  "common_params": {
    "seed": 0,
    "dimension": 2,
    "n_hidden": 2,
    "width_hidden": 32,
    "parametric_map": "node",
    "rhs_model": "mlp",
    "activation_fn": "tanh",
    "time_dependent": true,
    "ode_solver": "euler",
    "dt0": 0.1,
    "ref_density": "gaussian",
    "scale_factor": 1.0,
    "stepsize": 0.001,
    "N_samples": 512,
    "eval_samples": 128,
    "plot_n_samples": 256,
    "max_iterations": 50,
    "tolerance": 0.0001,
    "linear_solver": "cg",
    "live_plot_every": 10
  },
  "problems": [
    {
      "functional": {
        "kind": "MMD",
        "bw_multipliers": [0.1, 1.0, 10.0],
        "bandwidth_samples": 512
      },
      "distribution": {
        "name": "2spirals",
        "n_samples": 2048,
        "resample_each": 20,
        "seed": 3
      }
    }
  ],
  "methods": {
    "gradient_flow": {},
    "anderson": {
      "relaxation": [1.0],
      "regularization_factor_gamma": [1e-5],
      "regularization_kind": ["adaptive"],
      "solver": ["cg"],
      "memory_size": [8],
      "ensure_descent": [true]
    }
  },
  "parallel": {
    "max_workers": 2,
    "gpu_ids": [7],
    "disable_preallocate": true
  },
  "plotting": {
    "figsize": [17, 6],
    "scatter_figsize": [8, 8],
    "method_colormaps": {
      "gradient_flow": "Blues",
      "anderson": "Reds"
    },
    "style_channels": ["color", "linestyle", "linewidth"],
    "style_values": {
      "linestyle": ["-", "--", ":"],
      "linewidth": [2.0, 1.5]
    },
    "scatter_size": 22,
    "gf_alpha": 0.45,
    "method_alpha": 0.55,
    "target_scatter_size": 6.0,
    "target_scatter_alpha": 0.9,
    "target_scatter_marker": "*",
    "target_scatter_facecolors": "none",
    "target_scatter_edgecolors": "#111111",
    "target_scatter_linewidths": 0.6,
    "target_scatter_zorder": 5,
    "target_scatter_label": "target"
  }
}
