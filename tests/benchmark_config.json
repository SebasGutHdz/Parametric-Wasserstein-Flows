{
  "output_root": "results/benchmarks",
  "common_params": {
    "seed": 0,
    "dimension": 2,
    "n_hidden": 2,
    "width_hidden": 16,
    "parametric_map": "node",
    "rhs_model": "mlp",
    "activation_fn": "tanh",
    "time_dependent": true,
    "ode_solver": "euler",
    "dt0": 0.01,
    "ref_density": "gaussian",
    "scale_factor": 1.0,
    "stepsize": 0.001,
    "N_samples": 100,
    "eval_samples": 30,
    "plot_n_samples": 20,
    "max_iterations": 3,
    "progress_every": 50
  },
  "distributions": [
    {
      "name": "gaussian",
      "mean_value": 2.0,
      "sigma_first": 1000.0,
      "sigma_second": 10.0
    },
    {
      "name": "double-banana",
      "shift": [0.0, 10.0]
    },
    {
      "name": "styblinski-tang"
    }
  ],
  "methods": {
    "gradient_flow": {
    },
    "anderson": {
      "relaxation": [1.25, 1.8],
      "regularization": [1e-5, 1e-3],
      "regularization_kind": ["l2", "adaptive"]
    },
    "memoryless_qn": {
      "regularization_strategy": ["Li-Fukushima", "Powell"],
      "hessian_update_strategy": ["preconvex", "BFGS"],
      "spectral_scaling": [true, false]
    }
  },
  "plotting": {
    "figsize": [17, 6],
    "scatter_figsize": [8, 8],
    "method_colormaps": {
      "gradient_flow": "Blues",
      "anderson": "Reds",
      "memoryless_qn": "Greens"
    },
    "style_channels": ["color", "linestyle", "linewidth", "marker"],
    "style_values": {
      "linestyle": ["-", "--", ":", "-.", "-"],
      "linewidth": [2.3, 1.9, 1.5, 1.2, 1.0],
      "marker": ["o", "^", "s", "D", "x", "P", "*", "v"]
    }
  }
}
